---
import type { Activity } from '../data/activities.ts';

interface Props {
  activity: Activity;
  /** Above-the-fold cards load eagerly; the rest wait. */
  eager?: boolean;
}

const { activity, eager = false } = Astro.props;
const free = /^free/i.test(activity.price);
---

<article class="card rev">
  <div class:list={['shot', activity.aspect]}>
    <img
      src={activity.photo}
      alt={activity.photoAlt}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      width={activity.aspect === 'portrait' ? 1480 : 1600}
      height={activity.aspect === 'portrait' ? 1850 : 1067}
    />
  </div>

  <div class="body">
    <h3>{activity.name}</h3>

    <p class="meta">
      <span class:list={['price', { free }]}>{activity.price}</span>
      <span class="dot" aria-hidden="true">·</span>
      <span class="dur">{activity.duration}</span>
    </p>

    <p class="blurb">{activity.blurb}</p>

    <ul class="facts">
      {activity.facts.map((fact) => <li>{fact}</li>)}
    </ul>

    {
      activity.link && (
        <a class="go" href={activity.link} rel="noopener noreferrer" target="_blank">
          {new URL(activity.link).hostname.replace(/^www\./, '')}
          <svg width="13" height="9" viewBox="0 0 15 9" fill="none" aria-hidden="true">
            <path
              d="M0 4.5h13M9.5 1 13 4.5 9.5 8"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      )
    }
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border-radius: 16px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.34);
    border: 1px solid var(--rule);
  }

  .shot {
    background: var(--limewash-2);
  }

  /* The ratio goes on the image, not the wrapper: height:100% against an
     auto-height flex parent resolves to auto, which let each photo keep its own
     shape and made the cards in a row disagree. */
  .shot img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  /* Show photography is shot tall. Cropping it to landscape throws most of the
     frame away, so those cards keep a portrait crop instead. Every card in a
     category shares one aspect, so rows still line up. */
  .shot.portrait img {
    aspect-ratio: 4 / 5;
  }

  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 16px 18px 18px;
  }

  h3 {
    font-size: 22px;
    letter-spacing: -0.02em;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 7px;
    margin: 8px 0 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
  }

  .price {
    font-weight: 600;
    color: var(--chili);
  }

  .price.free {
    color: var(--jade);
  }

  .dot {
    opacity: 0.4;
  }

  .dur {
    opacity: 0.66;
  }

  .blurb {
    margin: 12px 0 0;
    font-size: 15.5px;
    line-height: 1.55;
    opacity: 0.88;
  }

  .facts {
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule-soft);
  }

  .facts li {
    position: relative;
    padding: 7px 0 0 15px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 1.5;
    opacity: 0.72;
  }

  .facts li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 14px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--marigold);
  }

  .go {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 16px;
    padding-top: 14px;
    color: var(--chili);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-decoration: none;
    border-top: 1px solid transparent;
  }

  .go:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .go svg {
    transition: transform 0.24s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .go:hover svg {
    transform: translateX(4px);
  }

  /* Phones: the photo gets shorter so more of the card fits on screen. */
  @media (max-width: 560px) {
    .shot img {
      aspect-ratio: 16 / 9;
    }

    .shot.portrait img {
      aspect-ratio: 1 / 1;
    }

    .body {
      padding: 14px 16px 16px;
    }

    h3 {
      font-size: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .go svg {
      transition: none;
    }
  }
</style>
