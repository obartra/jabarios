---
interface Props {
  /** Rendered as plain text when this is the page the bar sits on. */
  current?: boolean;
}
const { current = false } = Astro.props;
---

<div class="appbar">
  <div class="wrap">
    <a class="mark" href="/" aria-current={current ? 'page' : undefined}>
      <span class="dot" aria-hidden="true"></span>Jabarios
    </a>
    <nav aria-label="Primary">
      <a href="/#trips">Trips</a>
    </nav>
  </div>
</div>

<style>
  .appbar {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(233, 220, 195, 0.9);
    backdrop-filter: saturate(1.3) blur(12px);
    -webkit-backdrop-filter: saturate(1.3) blur(12px);
    border-bottom: 1px solid rgba(26, 18, 13, 0.14);
  }

  .appbar :global(.wrap) {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 56px;
  }

  .mark {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-right: auto;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.025em;
    text-decoration: none;
  }

  .dot {
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--chili);
    box-shadow: 0 0 0 3px rgba(168, 59, 39, 0.16);
  }

  nav {
    display: flex;
    gap: 4px;
  }

  nav a {
    padding: 8px 12px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    opacity: 0.72;
    transition:
      background 0.18s ease,
      opacity 0.18s ease;
  }

  nav a:hover {
    background: var(--wash);
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    nav a {
      transition: none;
    }
  }
</style>
