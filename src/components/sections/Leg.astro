---
import { Picture } from 'astro:assets';
import { emphasis, type Section } from '../../data/pages.ts';
import { photoOf, type Trip } from '../../data/trips.ts';
import { photo, WIDTHS } from '../../lib/photos.ts';

/**
 * One stretch of a trip: a numbered head, then blocks in order. Light, or
 * "sea" for the dark legs. Thailand is built from these, one per leg, plus the
 * booking checklist and the practical notes.
 */
interface Props {
  trip: Trip;
  section: Extract<Section, { type: 'leg' }>;
}

const { trip, section } = Astro.props;
const altFor = (file: string, alt?: string) => alt ?? photoOf(trip, file).alt;
---

<section
  id={section.id}
  class:list={['leg', { sea: section.theme === 'sea', ruled: section.rule }]}
>
  {
    section.rule && (
      <div class="wrap">
        <hr class="rule" />
      </div>
    )
  }
  <div class="wrap">
    {
      section.title && (
        <>
          <div class="sechead">
            {section.number && <span class="secnum">{section.number}</span>}
            <h2>{section.title}</h2>
          </div>
          {section.meta && <p class="secmeta">{section.meta}</p>}
          {section.intro && <p class="intro">{section.intro}</p>}
        </>
      )
    }
    {
      section.blocks.map((block) => {
        switch (block.kind) {
          case 'clock':
            return (
              <div class="block clock">
                <div class="bar">
                  {block.segments.map((s) => (
                    <div class:list={['seg', s.tone]}>
                      <span class="t">{s.time}</span>
                      <span class="l">{s.label}</span>
                    </div>
                  ))}
                </div>
                {block.legend.length > 0 && (
                  <div class="legend">
                    {block.legend.map((l) => (
                      <span>{l}</span>
                    ))}
                  </div>
                )}
              </div>
            );
          case 'figure':
            return (
              <figure class="block figure">
                <Picture
                  src={photo(trip.slug, block.file)}
                  alt={altFor(block.file, block.alt)}
                  formats={['webp']}
                  widths={WIDTHS}
                  sizes="(max-width: 1180px) calc(100vw - 32px), 1180px"
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>{block.caption}</figcaption>
              </figure>
            );
          case 'prose':
            return (
              <div class="block prose">
                {block.eyebrow && <p class="eyebrow">{block.eyebrow}</p>}
                {block.paragraphs.map((p) => (
                  <p class="intro" set:html={emphasis(p)} />
                ))}
              </div>
            );
          case 'fine':
            return (
              <div class="block fine">
                {block.paragraphs.map((p) => (
                  <p set:html={emphasis(p)} />
                ))}
              </div>
            );
          case 'windows':
            return (
              <div class="block windows">
                {block.items.map((w) => (
                  <div class:list={['win', { free: w.free }]}>
                    <div class="d">{w.day}</div>
                    <div class="w">{w.weekday}</div>
                    <div class="a">
                      <b>{w.head}</b>
                      {w.text}
                    </div>
                  </div>
                ))}
              </div>
            );
          case 'options':
            return (
              <div class="block options">
                <h3 class="grouphead">{block.title}</h3>
                {block.sub && <p class="groupsub">{block.sub}</p>}
                <div class="optgrid">
                  {block.items.map((o) => (
                    <div class="opt rev">
                      <h4>{o.title}</h4>
                      <div class="meta">{o.meta}</div>
                      <p>{o.text}</p>
                      {o.chips.length > 0 && (
                        <div class="chips">
                          {o.chips.map((c) => (
                            <span class:list={['chip', c.kind]}>{c.text}</span>
                          ))}
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            );
          case 'rows':
            return (
              <div class="block">
                {block.title && <h3 class="grouphead">{block.title}</h3>}
                {block.sub && <p class="groupsub">{block.sub}</p>}
                <div class="rows">
                  {block.items.map((r) => (
                    <div class="row hi">
                      <div class="k">{r.k}</div>
                      <div class="v">{r.v}</div>
                    </div>
                  ))}
                </div>
              </div>
            );
          case 'cards':
            return (
              <div class="block">
                {block.eyebrow && <p class="eyebrow">{block.eyebrow}</p>}
                <div class:list={['grid', block.columns === 3 ? 'g3' : 'g2']}>
                  {block.items.map((c) => (
                    <div class="card rev">
                      <h3>{c.title}</h3>
                      {c.sub && <div class="sub">{c.sub}</div>}
                      <p>{c.text}</p>
                      {c.link && (
                        <a class="link" href={c.link.href}>
                          {c.link.label} →
                        </a>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            );
          case 'callout':
            return (
              <div class="block card rev">
                <h3>{block.title}</h3>
                <p>{block.text}</p>
              </div>
            );
          case 'dives':
            return (
              <div class="block">
                {block.eyebrow && <p class="eyebrow">{block.eyebrow}</p>}
                <div class="dives">
                  {block.items.map((d) => (
                    <div class="dive">
                      <span class="day-n">{d.day}</span>
                      <span class="site">{d.site}</span>
                      <span class="depth">{d.depth}</span>
                      <span class="note">{d.note}</span>
                    </div>
                  ))}
                </div>
              </div>
            );
          case 'checklist':
            return (
              <ol class="block check">
                {block.items.map((i) => (
                  <li>
                    <span class="what">
                      <b>{i.lead}</b> {i.text}
                    </span>
                    <span class="by">{i.by}</span>
                  </li>
                ))}
              </ol>
            );
          case 'notes':
            return (
              <div class="block">
                {block.eyebrow && <p class="eyebrow">{block.eyebrow}</p>}
                <div class="notes">
                  {block.items.map((n) => (
                    <div class="note">
                      <h3>{n.title}</h3>
                      <p>{n.text}</p>
                    </div>
                  ))}
                </div>
              </div>
            );
        }
      })
    }
  </div>
</section>

<style>
  /* One rhythm between blocks, instead of a margin per block. */
  .block + .block {
    margin-top: 40px;
  }
  .block.fine,
  .figure + .figure {
    margin-top: 16px;
  }
  .ruled {
    padding-top: 0;
  }
  .ruled .sechead {
    padding-top: 60px;
  }
  .sechead + .secmeta + .block,
  .sechead + .secmeta + .intro + .block {
    margin-top: 34px;
  }
  .fine p {
    font-size: 14.5px;
    opacity: 0.72;
    max-width: 62ch;
  }
  .fine p + p {
    margin-top: 10px;
  }
  .prose .intro {
    margin-top: 8px;
  }

  .sea a:focus-visible {
    outline-color: var(--surf);
  }

  .leg {
    padding: 78px 0;
  }

  .rule {
    height: 1px;
    background: rgba(26, 18, 13, 0.18);
    border: 0;
    margin: 0;
  }

  .sechead {
    display: flex;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 6px;
  }

  .secnum {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.14em;
    opacity: 0.72;
  }

  .sechead h2 {
    font-size: clamp(32px, 5.2vw, 58px);
  }

  .secmeta {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12.5px;
    opacity: 0.72;
    margin-bottom: 34px;
  }

  .intro {
    max-width: 56ch;
    font-size: 18px;
  }

  .grid {
    display: grid;
    gap: 16px;
  }

  .g3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .g2 {
    grid-template-columns: repeat(2, 1fr);
  }

  .card {
    background: rgba(255, 255, 255, 0.42);
    border: 1px solid rgba(26, 18, 13, 0.16);
    border-radius: 3px;
    padding: 20px;
  }

  .card h3,
  .card h4 {
    font-size: 20px;
    margin-bottom: 4px;
  }

  .card .sub {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11.5px;
    opacity: 0.72;
    margin-bottom: 10px;
  }

  .card p {
    font-size: 15.5px;
    margin-bottom: 0;
    opacity: 0.88;
  }

  .card .link {
    display: inline-block;
    margin-top: 12px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: var(--chili);
    text-decoration: none;
    border-bottom: 1px solid rgba(168, 59, 39, 0.4);
    padding-bottom: 1px;
  }

  .card .link:hover {
    border-bottom-color: var(--chili);
  }

  .clock {
    margin: 34px 0 0;
    border: 1px solid rgba(26, 18, 13, 0.18);
    border-radius: 3px;
    overflow: hidden;
  }

  .clock .bar {
    display: flex;
    height: 52px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
  }

  .clock .seg {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 6px;
    line-height: 1.25;
  }

  .clock .seg .l {
    opacity: 0.75;
  }

  .clock .seg.out .l {
    opacity: 1;
  }

  .seg.calls {
    background: var(--lacquer);
    color: #e9dcc3;
    flex: 5;
  }

  .seg.sleep {
    background: rgba(47, 110, 99, 0.22);
    flex: 5.5;
  }

  .seg.out {
    background: var(--marigold);
    color: #1a120d;
    flex: 8;
  }

  .seg.night {
    background: rgba(26, 18, 13, 0.1);
    flex: 5.5;
  }

  .clock .legend {
    display: flex;
    justify-content: space-between;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    opacity: 0.72;
    padding: 8px 12px;
    border-top: 1px solid rgba(26, 18, 13, 0.14);
  }

  .rows {
    display: grid;
    gap: 9px;
  }

  .row {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 14px;
    align-items: start;
  }

  .row .k {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.72;
    padding-top: 4px;
  }

  .row .v {
    font-size: 15.5px;
  }

  .row.hi .k {
    color: var(--chili);
    opacity: 1;
  }

  .figure {
    margin-top: 16px;
  }

  .figure :global(img) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 2px;
  }

  .figure figcaption {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    opacity: 0.72;
    margin-top: 6px;
  }

  .sea {
    background: var(--abyss);
    color: var(--foam);
  }

  .sea .rule {
    background: rgba(214, 231, 227, 0.16);
  }

  .sea .eyebrow,
  .sea .secnum,
  .sea .secmeta {
    color: var(--foam);
  }

  .sea .card {
    background: rgba(214, 231, 227, 0.05);
    border-color: rgba(214, 231, 227, 0.16);
  }

  .sea .card .link {
    color: var(--surf);
    border-bottom-color: rgba(79, 208, 198, 0.4);
  }

  .sea .row.hi .k {
    color: var(--surf);
  }

  .dives {
    margin-top: 26px;
    border-top: 1px solid rgba(214, 231, 227, 0.16);
  }

  .dive {
    display: grid;
    grid-template-columns: 104px 1fr 92px;
    gap: 16px;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px solid rgba(214, 231, 227, 0.12);
  }

  .dive .site {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 18px;
    font-weight: 500;
  }

  .dive .note {
    font-size: 14.5px;
    opacity: 0.72;
    grid-column: 2;
  }

  .dive .depth {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    text-align: right;
    color: var(--surf);
  }

  .dive .day-n {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.72;
  }

  .check {
    counter-reset: c;
    display: grid;
    gap: 0;
    margin-top: 26px;
  }

  .check li {
    list-style: none;
    display: grid;
    grid-template-columns: 44px 1fr 128px;
    gap: 16px;
    padding: 16px 0;
    border-top: 1px solid rgba(26, 18, 13, 0.16);
    align-items: baseline;
  }

  .check li:last-child {
    border-bottom: 1px solid rgba(26, 18, 13, 0.16);
  }

  .check li::before {
    counter-increment: c;
    content: counter(c, decimal-leading-zero);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    opacity: 0.72;
  }

  .check .what {
    font-size: 16px;
  }

  .check .what b {
    font-weight: 600;
  }

  .check .by {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11.5px;
    text-align: right;
    color: var(--chili);
  }

  .notes {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 40px;
  }

  .note {
    padding: 18px 0;
    border-top: 1px solid rgba(26, 18, 13, 0.16);
  }

  .note h3,
  .note h4 {
    font-size: 17px;
    margin-bottom: 6px;
  }

  .note p {
    font-size: 15px;
    margin: 0;
    opacity: 0.85;
  }

  .windows {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 10px;
    margin-top: 26px;
  }

  .win {
    border: 1px solid rgba(26, 18, 13, 0.18);
    border-radius: 3px;
    padding: 12px 12px 14px;
    background: rgba(255, 255, 255, 0.3);
  }

  .win.free {
    background: rgba(201, 135, 27, 0.16);
    border-color: rgba(201, 135, 27, 0.5);
  }

  .win .d {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 24px;
    font-weight: 600;
    line-height: 1;
  }

  .win .w {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.72;
    margin: 3px 0 8px;
  }

  .win .a {
    font-size: 13.5px;
    line-height: 1.4;
  }

  .win .a b {
    display: block;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-bottom: 3px;
  }

  .optgrid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    margin-top: 18px;
  }

  .opt {
    border: 1px solid rgba(26, 18, 13, 0.16);
    border-radius: 3px;
    padding: 17px;
    background: rgba(255, 255, 255, 0.34);
  }

  .opt h4 {
    font-size: 18.5px;
    margin-bottom: 3px;
  }

  .opt .meta {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    opacity: 0.72;
    margin-bottom: 9px;
  }

  .opt p {
    font-size: 15px;
    margin: 0;
    opacity: 0.9;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 11px;
  }

  .chip {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1px solid rgba(26, 18, 13, 0.22);
    border-radius: 999px;
    padding: 3px 8px;
    opacity: 0.75;
  }

  .chip.key {
    border-color: var(--chili);
    color: var(--chili);
    opacity: 1;
  }

  .chip.dry {
    border-color: var(--jade);
    color: var(--jade);
    opacity: 1;
  }

  .grouphead {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 21px;
    font-weight: 600;
    margin: 38px 0 2px;
    padding-top: 20px;
    border-top: 1px solid rgba(26, 18, 13, 0.2);
  }

  .groupsub {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11.5px;
    opacity: 0.72;
  }

  @media (max-width: 1000px) {
    .g3 {
      grid-template-columns: repeat(2, 1fr);
    }

    .windows {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 860px) {
    .g3,
    .g2 {
      grid-template-columns: 1fr;
    }

    .notes {
      grid-template-columns: 1fr;
    }

    .check li {
      grid-template-columns: 34px 1fr;
    }

    .check .by {
      grid-column: 2;
      text-align: left;
    }

    .dive {
      grid-template-columns: 1fr 84px;
      gap: 4px 12px;
    }

    .dive .day-n {
      grid-column: 1/-1;
    }

    .dive .note {
      grid-column: 1/-1;
    }

    .leg {
      padding: 56px 0;
    }

    .clock .bar {
      display: block;
      height: auto;
    }

    .clock .seg {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      text-align: left;
      padding: 9px 12px;
      font-size: 12px;
    }

    .clock .seg {
      flex-direction: row;
    }

    .clock .seg .l {
      opacity: 0.8;
    }

    .clock .legend {
      flex-direction: column;
      gap: 3px;
      align-items: flex-start;
      line-height: 1.45;
    }

    .row {
      grid-template-columns: 56px 1fr;
    }

    .row .v {
      font-size: 15px;
    }

    .card {
      padding: 17px;
    }

    .windows {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }

    .optgrid {
      grid-template-columns: 1fr;
    }

    .figure :global(img) {
      border-radius: 2px;
    }
  }

  @media (max-width: 420px) {
    .row {
      grid-template-columns: 1fr;
      gap: 2px;
    }

    .row .k {
      padding-top: 0;
    }
  }
</style>
