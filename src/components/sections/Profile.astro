---
import type { Section } from '../../data/pages.ts';

/**
 * The height-and-depth line through a trip. The chart is drawn from each
 * stop's authored position; the phone version beneath it is derived from the
 * same stops, so the two always agree. Heights and depths are on separate
 * scales, and the phone bars use a square root for height so a 2 m city and a
 * 2,565 m summit both stay visible.
 */
interface Props {
  section: Extract<Section, { type: 'profile' }>;
}

const { section } = Astro.props;
const { stops } = section;

const SEA = 132;
const metres = (m: number) =>
  m < 0 ? `−${Math.abs(m).toLocaleString('en')} m` : `${m.toLocaleString('en')} m`;
const value = (s: (typeof stops)[number]) =>
  s.date ? `${metres(s.metres)} · ${s.date}` : metres(s.metres);

const highest = Math.max(...stops.map((s) => s.metres));
const deepest = Math.min(...stops.map((s) => s.metres));
/** Widest bar each way, as a share of half the track. */
const UP = 36;
const DOWN = 31.5;
const bar = (m: number) =>
  m >= 0 ? Math.max(0.6, UP * Math.sqrt(m / highest)) : DOWN * (Math.abs(m) / Math.abs(deepest));

const points = stops.map((s) => `${s.x},${s.y}`).join(' ');
---

<section class="profile-section">
  <div class="wrap profile-shell">
    <div class="profile-scroll">
      <svg viewBox="0 0 1200 320" role="img" aria-label={section.label}>
        <defs>
          <linearGradient id="water" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#08303B"></stop>
            <stop offset="100%" stop-color="#04222B"></stop>
          </linearGradient>
        </defs>
        <rect x="0" y={SEA} width="1200" height={320 - SEA} fill="url(#water)"></rect>
        <line x1="0" y1={SEA} x2="1200" y2={SEA} stroke="#4FD0C6" stroke-width="1" opacity=".7"
        ></line>
        <text class="node-val" x="8" y={SEA - 6}>sea level</text>
        <polyline class="trace draw" points={points}></polyline>
        <g>
          {
            stops.map((s) => {
              const below = s.metres < 0;
              const fill = below ? '#4FD0C6' : '#A83B27';
              if (s.mode === 'inline') {
                return (
                  <>
                    <circle cx={s.x} cy={s.y} r="4" fill={fill} />
                    <text class="node-label" x={s.x + 40} y={s.y + 4} text-anchor={s.anchor}>
                      {s.name} · {metres(s.metres)}
                    </text>
                  </>
                );
              }
              if (s.mode === 'name') {
                return (
                  <>
                    <circle cx={s.x} cy={s.y} r="4" fill={fill} />
                    <text class="node-val" x={s.x} y={s.y - 15} text-anchor={s.anchor}>
                      {s.name.toLowerCase()}
                    </text>
                  </>
                );
              }
              const labelY = below ? s.y + 20 : s.y - 15;
              const valueY = below ? s.y + 34 : s.y - 29;
              return (
                <>
                  <circle cx={s.x} cy={s.y} r="4" fill={fill} />
                  <text
                    class:list={['node-label', { sea: below }]}
                    x={s.x}
                    y={labelY}
                    text-anchor={s.anchor}
                  >
                    {s.name}
                  </text>
                  <text
                    class:list={['node-val', { sea: below }]}
                    x={s.x}
                    y={valueY}
                    text-anchor={s.anchor}
                  >
                    {s.chartValue ?? value(s)}
                  </text>
                </>
              );
            })
          }
        </g>
      </svg>
    </div>
    <div class="vprofile" aria-hidden="true">
      <div class="vp-scale">
        <span>{metres(deepest)}</span><span>sea level</span><span>+{metres(highest)}</span>
      </div>
      <ol>
        {
          stops.map((s) => (
            <li>
              <div class="vp-meta">
                <span class="vp-name">{s.name}</span>
                <span class:list={['vp-val', { deep: s.metres < 0 }]}>{value(s)}</span>
              </div>
              <div class="vp-track">
                <span
                  class:list={['vp-bar', s.metres < 0 ? 'down' : 'up']}
                  style={`width:${bar(s.metres).toFixed(1)}%`}
                />
              </div>
            </li>
          ))
        }
      </ol>
    </div>
    {
      section.caption.length > 0 && (
        <div class="profile-cap">
          {section.caption.map((c) => (
            <span>{c}</span>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .profile-section {
    padding: 0 0 20px;
  }

  .profile-shell {
    margin: 46px 0 0;
    position: relative;
  }

  .profile-scroll {
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
  }

  .profile-scroll svg {
    display: block;
    min-width: 900px;
    width: 100%;
    height: auto;
  }

  .profile-cap {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11.5px;
    opacity: 0.72;
    padding: 10px 0 0;
    border-top: 1px solid rgba(26, 18, 13, 0.16);
    margin-top: 6px;
  }

  .node-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12.5px;
    fill: #1a120d;
  }

  .node-val {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    fill: #1a120d;
    opacity: 0.72;
  }

  .node-label.sea {
    fill: #d6e7e3;
  }

  .node-val.sea {
    fill: #d6e7e3;
    opacity: 0.72;
  }

  .trace {
    fill: none;
    stroke: #a83b27;
    stroke-width: 2.4;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .trace.draw {
    stroke-dasharray: 2600;
    stroke-dashoffset: 2600;
    animation: draw 2.6s 0.25s cubic-bezier(0.55, 0.1, 0.3, 1) forwards;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .vprofile {
    display: none;
    margin-top: 30px;
  }

  .vprofile .vp-scale {
    display: flex;
    justify-content: space-between;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    opacity: 0.72;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(26, 18, 13, 0.16);
  }

  .vprofile ol {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  .vprofile ol::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    background: rgba(26, 18, 13, 0.26);
  }

  .vprofile li {
    padding: 10px 0 12px;
    border-bottom: 1px solid rgba(26, 18, 13, 0.09);
  }

  .vp-track {
    position: relative;
    height: 10px;
    margin-top: 6px;
  }

  .vp-bar {
    position: absolute;
    top: 4px;
    height: 2px;
    background: var(--chili);
  }

  .vp-bar::after {
    content: '';
    position: absolute;
    top: -3px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--chili);
  }

  .vp-bar.up {
    left: 50%;
  }

  .vp-bar.up::after {
    right: -4px;
  }

  .vp-bar.down {
    right: 50%;
    background: var(--jade);
  }

  .vp-bar.down::after {
    left: -4px;
    background: var(--jade);
  }

  .vp-meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: baseline;
    position: relative;
    z-index: 1;
  }

  .vp-name {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 15px;
    font-weight: 600;
  }

  .vp-val {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    opacity: 0.72;
    white-space: nowrap;
  }

  .vp-val.deep {
    color: var(--jade);
    opacity: 0.95;
  }

  @media (prefers-reduced-motion: reduce) {
    .trace.draw {
      animation: none;
      stroke-dashoffset: 0;
    }
  }

  @media (max-width: 860px) {
    .profile-scroll,
    .profile-cap {
      display: none;
    }

    .vprofile {
      display: block;
    }
  }
</style>
