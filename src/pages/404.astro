---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Not found · Jabarios"
  description="That page isn't here."
  path="/404.html"
  noindex
>
  <div class="box">
    <p class="code">Error 404</p>
    <h1>No trip <em>this way</em>.</h1>
    <p class="say">That page has either moved or was never here.</p>
    <a class="home" href="/">
      <svg width="13" height="9" viewBox="0 0 13 9" fill="none" aria-hidden="true">
        <path
          d="M13 4.5H1M4.5 1 1 4.5 4.5 8"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      All trips
    </a>
  </div>
</BaseLayout>

<style>
  :global(body) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 40px 22px;
    text-align: center;
  }

  .box {
    max-width: 34ch;
  }

  .code {
    margin: 0 0 16px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  h1 {
    margin: 0 0 16px;
    font-size: clamp(38px, 9vw, 62px);
    letter-spacing: -0.03em;
  }

  h1 em {
    font-style: normal;
    color: var(--chili);
  }

  .say {
    margin: 0 0 30px;
    opacity: 0.82;
  }

  .home {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 13px 22px;
    border-radius: 999px;
    background: var(--lacquer);
    color: var(--limewash);
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 0.22s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .home:hover {
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .home {
      transition: none;
    }
  }
</style>
