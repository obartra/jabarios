---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import TripNav from '../../components/TripNav.astro';
import TripHero from '../../components/TripHero.astro';
import TripShape from '../../components/TripShape.astro';
import SectionHead from '../../components/SectionHead.astro';
import ActivityGroups from '../../components/ActivityGroups.astro';
import BookingOrder from '../../components/BookingOrder.astro';
import { tripBySlug } from '../../data/trips.ts';
import { groupedFor } from '../../data/activities.ts';

const trip = tripBySlug('january');
const groups = groupedFor('january');

const sections = [
  ...groups.map((g) => ({ href: `#${g.id}`, label: g.short })),
  { href: '#pairs', label: 'Two weeks' },
  { href: '#also', label: 'Also' },
];

const paragraphs = [
  'Os flies down from Philadelphia on 27 December, already booked, and lands in Salvador on the 28th for New Year with friends. Around the 9th we meet, and the two weeks from there are ours.',
  'Where is open. The shortlist is three places that are new to both of us, dry in January, and split between a city and something outdoors. Os books the rentals, at up to about $1,000 a week, and the rest stays cheap.',
];

const notes = [
  {
    lead: 'Chile is the first choice.',
    rest: 'The best mix of city, nature and animals, the driest weather, and a new nonstop from Salvador to Santiago in January. The cost is Jabari’s longer flight.',
  },
  {
    lead: 'The moon helps early.',
    rest: 'New moon on 7 January, full on the 22nd. For stargazing in Elqui, the first week is the one.',
  },
  {
    lead: 'Two directions of travel.',
    rest: 'Os comes from Salvador, Jabari from Philadelphia. Chile and Buenos Aires are nonstop for Os; Colombia is one stop for each of us.',
  },
];

const pairs = [
  {
    name: 'Chile',
    when: '6 nights, then 8',
    detail:
      'Valparaíso and Santiago first, then a one-hour flight or a cheap bus north to La Serena and up into the Elqui Valley. Penguins one day, observatories at night.',
  },
  {
    name: 'Colombia',
    when: '7 nights, then 7',
    detail:
      'Medellín first, then a 6–7 hour bus or a short flight to the coffee region. The cheapest of the three to live on.',
  },
  {
    name: 'Buenos Aires and Uruguay',
    when: '9 nights, then 5',
    detail:
      'Buenos Aires, then the ferry to Colonia and on to Montevideo. The most city and the least nature, and the hottest.',
  },
];

const also = [
  {
    name: 'Mexico',
    where: 'Been',
    detail: 'Mexico City, Oaxaca and Mérida all fit January well, but we have both been.',
  },
  {
    name: 'Rio, Paraty, Florianópolis',
    where: 'Weather',
    detail:
      'Peak summer on the Brazilian coast: storms most afternoons, and the highest prices of the year.',
  },
  {
    name: 'Iguazú, the Andes, the Atacama',
    where: 'Weather',
    detail: 'Rainy or stormy season in January. Iguazú would only work as a two-night side trip.',
  },
  {
    name: 'Costa Rica, Puerto Vallarta',
    where: 'Budget',
    detail: 'Dry and good for animals, but January is peak season and rentals go over the cap.',
  },
  {
    name: 'The Galápagos',
    where: 'At 50 logged dives',
    detail: 'Its best diving asks for 50 logged dives, and neither of us is there yet.',
  },
];

const booking = [
  {
    label: 'Where',
    detail: 'Everything else waits on it.',
  },
  {
    label: 'Two sets of flights',
    detail: 'Os from Salvador, Jabari from Philadelphia, meeting around the 9th.',
  },
  {
    label: 'The rentals',
    detail: 'Two, one for each half. Os is handling them.',
  },
];

const caveat =
  'Researched in September 2026. Weather is from climate averages, rental prices from rental-market data, and flights and ferry fares are not checked on a booking site yet. Nothing here is booked.';

const note =
  `<strong style="color:#E9DCC3">${trip.name} · ${trip.dateLabel}</strong><br>` +
  'Rough dates, and where is not decided yet.';
---

<BaseLayout
  title={trip.title}
  description={trip.description}
  path={trip.href}
  image={trip.cover}
  ogType="article"
>
  <TripHero trip={trip} maxWidth="17ch">Two weeks, <em>somewhere new</em>.</TripHero>

  <TripNav sections={sections} />

  <TripShape paragraphs={paragraphs} notes={notes} />

  <ActivityGroups groups={groups} />

  <section id="pairs" class="list">
    <div class="wrap">
      <SectionHead title="Making it two weeks" note="How each option splits the fortnight." />
      <ul class="places">
        {
          pairs.map((p) => (
            <li>
              <div class="who">
                <b>{p.name}</b>
                <span>{p.when}</span>
              </div>
              <p>{p.detail}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="also" class="list">
    <div class="wrap">
      <SectionHead title="Also looked at" note="And why they are not on the shortlist." />
      <ul class="places">
        {
          also.map((p) => (
            <li>
              <div class="who">
                <b>{p.name}</b>
                <span>{p.where}</span>
              </div>
              <p>{p.detail}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <BookingOrder
    intro="Three things, and the first decides the rest."
    items={booking}
    caveat={caveat}
  />

  <SiteFooter credits={trip.credits} note={note} />
</BaseLayout>

<style>
  .list {
    padding: 54px 0 20px;
  }

  .places {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 2px;
  }

  .places li {
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: 18px;
    padding: 18px 0;
    border-top: 1px solid rgba(26, 18, 13, 0.14);
  }

  .places li:last-child {
    border-bottom: 1px solid rgba(26, 18, 13, 0.14);
  }

  .places .who b {
    display: block;
    font-size: clamp(17px, 2vw, 20px);
  }

  .places .who span {
    display: block;
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    opacity: 0.72;
  }

  .places p {
    margin: 0;
    max-width: 62ch;
    opacity: 0.84;
  }

  @media (max-width: 760px) {
    .places li {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
