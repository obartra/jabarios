---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import TripNav from '../../components/TripNav.astro';
import TripHero from '../../components/TripHero.astro';
import TripShape from '../../components/TripShape.astro';
import SectionHead from '../../components/SectionHead.astro';
import ActivityGroups from '../../components/ActivityGroups.astro';
import BookingOrder from '../../components/BookingOrder.astro';
import { tripBySlug } from '../../data/trips.ts';
import { groupedFor } from '../../data/activities.ts';

const trip = tripBySlug('january');
const groups = groupedFor('january');

const sections = [
  ...groups.map((g) => ({ href: `#${g.id}`, label: g.short })),
  { href: '#pairs', label: 'Two weeks' },
  { href: '#also', label: 'Also' },
];

const paragraphs = [
  'Os flies down from Philadelphia on 27 December, already booked, and lands in Salvador on the 28th for New Year with friends. Around the 9th we meet, and the two weeks from there are ours.',
  'Where is open. Northern Brasil was the first idea, but the Lençóis lagoons are dry in January, and without them the reason to go went too. So this is a shortlist, picked for what is actually at its best in the middle of January.',
];

const notes = [
  {
    lead: 'Animals, water, and a city somewhere.',
    rest: 'Jabari is happy with nature and animals and just as happy exploring a new city, so the best two weeks probably have some of both rather than fourteen days on boats.',
  },
  {
    lead: 'The moon matters.',
    rest: 'New moon on 7 January, full on the 22nd. Anything that wants a dark sky, stars or bioluminescence, belongs in the first week.',
  },
  {
    lead: 'One thing has a deadline.',
    rest: 'The Silver Bank week of 16 to 23 January is the only January departure still listed. If it is in, it wants deciding soon.',
  },
  {
    lead: 'Two directions of travel.',
    rest: 'Os comes from Salvador, where Copa flies to Panama four times a week and connects onward. Jabari comes from Philadelphia. A place that is easy for both is worth something.',
  },
];

const pairs = [
  {
    name: 'Bonaire, then the Silver Bank',
    when: '9 to 16, then 16 to 23 January',
    detail:
      'Jabari certifies in the first week and we dive together; the whale week needs no certification anyway. The most animals, and the most expensive, but almost no city in it. The hop from Curaçao to the Dominican Republic probably goes through Panama or Miami.',
  },
  {
    name: 'Santo Domingo, then the Silver Bank',
    when: '9 to 15, then 16 to 23 January',
    detail:
      'The option with a city in it, and one country for both weeks. The Colonial Zone is the oldest European-built city in the Americas, walkable, with the food and nights to go with it, and the boats leave from Puerto Plata on the north coast. Samaná’s own whale season opens around 15 January too.',
  },
  {
    name: 'The Galápagos, on its own',
    when: 'Both weeks',
    detail:
      'Animals everywhere and enough on its own for two weeks, with Quito or Guayaquil as the city on the way in.',
  },
];

const also = [
  {
    name: 'Dominica',
    where: 'Sperm whales',
    detail:
      'January to March is the peak, and boat trips find them most days. Swimming with them needs a limited special permit. Flights go through Barbados or Antigua, and the island is still socially conservative.',
  },
  {
    name: 'Fernando de Noronha',
    where: 'Not this month',
    detail:
      'The best diving in Brasil, but January is the heart of its swell season and the boats are rough. August to October is the time.',
  },
  {
    name: 'Chapada Diamantina',
    where: 'Before the 9th, maybe',
    detail:
      'Rainy season, muddy trails and full waterfalls. Better as a side trip from Salvador for Os than as our two weeks.',
  },
  {
    name: 'The Atacama',
    where: 'Not this month',
    detail:
      'January is the altiplanic winter, with evening cloud that cancels stargazing tours, and the full moon on the 22nd.',
  },
  {
    name: 'Patagonia',
    where: 'Peak season',
    detail: 'Windy, booked a year ahead, expensive, and no diving.',
  },
  {
    name: 'Cozumel, Belize, Roatán, Providencia',
    where: 'Fine, not standout',
    detail:
      'Good diving, but January brings northers that close ports and cancel boats. Nothing here is special to the month.',
  },
];

const booking = [
  {
    label: 'Where',
    detail: 'Everything else waits on it.',
  },
  {
    label: 'The Silver Bank, if it is in',
    detail: 'One January departure left, 16 to 23 January.',
  },
  {
    label: 'Two sets of flights',
    detail: 'Os from Salvador, Jabari from Philadelphia, meeting around the 9th.',
  },
];

const caveat =
  'Researched in September 2026 from operators’ and tourism sites. The Silver Bank prices and dates are from the operator; the Bonaire nature fee, some routings and the Dominica permit are not confirmed. Nothing here is booked.';

const note =
  `<strong style="color:#E9DCC3">${trip.name} · ${trip.dateLabel}</strong><br>` +
  'Rough dates, and where is not decided yet.';
---

<BaseLayout
  title={trip.title}
  description={trip.description}
  path={trip.href}
  image={trip.cover}
  ogType="article"
>
  <TripHero trip={trip} maxWidth="17ch">Two weeks, <em>somewhere good</em>.</TripHero>

  <TripNav sections={sections} />

  <TripShape paragraphs={paragraphs} notes={notes} />

  <ActivityGroups groups={groups} />

  <section id="pairs" class="list">
    <div class="wrap">
      <SectionHead title="Making it two weeks" note="Three ways the shortlist fits together." />
      <ul class="places">
        {
          pairs.map((p) => (
            <li>
              <div class="who">
                <b>{p.name}</b>
                <span>{p.when}</span>
              </div>
              <p>{p.detail}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="also" class="list">
    <div class="wrap">
      <SectionHead title="Also looked at" note="And why they are not on the shortlist." />
      <ul class="places">
        {
          also.map((p) => (
            <li>
              <div class="who">
                <b>{p.name}</b>
                <span>{p.where}</span>
              </div>
              <p>{p.detail}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <BookingOrder
    intro="Only three things, and the first decides the rest."
    items={booking}
    caveat={caveat}
  />

  <SiteFooter credits={trip.credits} note={note} />
</BaseLayout>

<style>
  .list {
    padding: 54px 0 20px;
  }

  .places {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 2px;
  }

  .places li {
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: 18px;
    padding: 18px 0;
    border-top: 1px solid rgba(26, 18, 13, 0.14);
  }

  .places li:last-child {
    border-bottom: 1px solid rgba(26, 18, 13, 0.14);
  }

  .places .who b {
    display: block;
    font-size: clamp(17px, 2vw, 20px);
  }

  .places .who span {
    display: block;
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    opacity: 0.72;
  }

  .places p {
    margin: 0;
    max-width: 62ch;
    opacity: 0.84;
  }

  @media (max-width: 760px) {
    .places li {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
