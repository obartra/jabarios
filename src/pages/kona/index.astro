---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import TripNav from '../../components/TripNav.astro';
import TripHero from '../../components/TripHero.astro';
import TripShape from '../../components/TripShape.astro';
import SectionHead from '../../components/SectionHead.astro';
import ActivityGroups from '../../components/ActivityGroups.astro';
import BookingOrder from '../../components/BookingOrder.astro';
import { tripBySlug } from '../../data/trips.ts';
import { groupedFor } from '../../data/activities.ts';
import { durationDays, requireDates } from '../../lib/trips.ts';

const trip = tripBySlug('kona');
const groups = groupedFor('kona');
const nights = durationDays(requireDates(trip, trip.slug)) - 1;

const sections = [
  { href: '#week', label: 'The week' },
  { href: '#mauna-kea', label: 'Mauna Kea' },
  ...groups.map((g) => ({ href: `#${g.id}`, label: g.short })),
  { href: '#around', label: 'Getting around' },
];

const paragraphs = [
  'The Big Island rather than Oahu, because the manta night dive is off Kona and nowhere near Honolulu. About 200,000 people on an island bigger than all the others put together, and an open-air airport where everyone walks down the stairs into the sun.',
  'Three days have something in them. The others are free, and the cards further down are for those, or for nothing.',
];

const notes = [
  {
    lead: 'Diving and altitude do not mix.',
    rest: 'Both Mauna Kea operators refuse anyone who has been on scuba in the previous 24 hours, and the flight home wants a clear day too. That is what sets the order: underwater Tuesday and Wednesday, the mountain on Thursday, dry land after.',
  },
  {
    lead: 'The house is booked.',
    rest: 'Kailua-Kona, up the hill from the bay, from 15:00 on Sunday the 6th to 10:00 on Sunday the 13th. The dive shops and the town car rental are a short walk away.',
  },
  {
    lead: 'A car for one day, not seven.',
    rest: 'Everything in town is on foot or on the Kona Trolley, the boats and the mountain are rides, and Saturday is the one day that needs wheels.',
  },
  {
    lead: 'Mornings are for work, for whoever is working.',
    rest: 'Kona is 5 hours behind Miami, so a 9:00 Miami start is 4:00 here and the workday is over by lunch.',
  },
];

/** Three fixed days, in the order the diving and the altitude allow. */
const timeline = [
  {
    when: 'Sun 6 Dec',
    what: 'Into Kona',
    detail:
      'A ride from KOA, about 20 minutes, and the house from 15:00. Sunset on the seawall if the flight allows.',
  },
  {
    when: 'Mon 7 Dec',
    what: 'Nothing booked',
    detail:
      'Down the hill to Aliʻi Drive, the trolley to Kahalu‘u to snorkel with the turtles, and getting over the Pacific.',
  },
  {
    when: 'Tue 8 · afternoon',
    what: 'The mantas',
    detail:
      'One boat for both of us from Honokōhau. Two tanks for Os, a day dive then the mantas after dark, and Jabari snorkels them from the surface under the same lights. Kaloko-Honokōhau is next to the harbour for before.',
  },
  {
    when: 'Wed 9 · morning',
    what: 'Jabari’s first dive',
    detail:
      'Discover Scuba, boat out around 8:30 and back by 13:00. Os dives the same boat or takes the morning off. Huliheʻe Palace reopens on Wednesdays, for the afternoon.',
  },
  {
    when: 'Thu 10 Dec',
    what: 'Mauna Kea',
    detail:
      'Picked up in town early afternoon, back around 22:00. More than 24 hours after the dive, which is the rule. The whole evening is below.',
  },
  {
    when: 'Fri 11 Dec',
    what: 'Free, and dry',
    detail: 'Town, the palace, the market, Magic Sands if the sand is in, or nothing.',
  },
  {
    when: 'Sat 12 Dec',
    what: 'The car day',
    detail:
      'Picked up in town between 9:00 and 12:00. South to the coffee farms, the place of refuge and Two Step, or the long drive to Volcanoes. Not both.',
  },
  {
    when: 'Sun 13 Dec',
    what: 'Out by 10:00',
    detail: 'Car back at KOA on the way to the flight, and on to Miami.',
  },
];

/** The Thursday, in order. */
const evening = [
  {
    step: 'Kailua-Kona',
    detail:
      'Pickup in town, then a 4WD van up the mountain, which rental cars are not allowed to drive.',
  },
  {
    step: '9,000 ft',
    detail:
      'Dinner at the mid-level station, partly for the food and partly to adjust to the height.',
  },
  {
    step: 'Nearly 14,000 ft',
    detail:
      'Sunset from the summit, around 17:45, above the clouds and among the big research observatories. Parkas and gloves are provided, because it is close to freezing up there.',
  },
  {
    step: 'Back to 9,000 ft',
    detail: 'A telescope session with hot drinks, on 11-inch scopes.',
  },
];

const sky = ['Jupiter', 'Saturn', 'Andromeda', 'The Orion Nebula', 'The Milky Way'];

/** The two that pick up in Kona. Checked on their own sites in September 2026. */
const tours = [
  {
    name: 'Hawaii Forest & Trail',
    price: 'From $315 each',
    url: 'https://hawaii-forest.com/tour_category/maunakea-summit-stargazing/',
    detail:
      'Twelve guests at most, a picnic dinner, and the deep-sky photos emailed afterwards. Pickup at the King Kamehameha, at the bottom of the hill. Free cancellation up to 24 hours before.',
  },
  {
    name: 'Mauna Kea Summit Adventures',
    price: 'From $330 each',
    url: 'https://maunakea.com/sunset-stargazing-tour/',
    detail:
      'The hot dinner, a lasagna at the visitor station. Pickup at Kona Crossroads at 13:55, back at 22:05 on the December schedule. No refunds inside 24 hours.',
  },
];

const around = [
  {
    name: 'The house',
    where: 'Up the hill from the bay',
    detail:
      'About 20 minutes on foot down to Aliʻi Drive, and the same back up, slower. Kona Brewing, the dive shops and the Enterprise office are all close.',
  },
  {
    name: 'From the airport',
    where: 'About 7 mi',
    detail: 'Uber or Lyft, reportedly $25 to $45. There is no car to collect, which is the point.',
  },
  {
    name: 'The Kona Trolley',
    where: 'Hele-On route 201',
    detail:
      'Along Aliʻi Drive between the Target park and ride and Keauhou, hourly from 6:00 to 21:00, every day. Magic Sands and Kahalu‘u are both on it. It was free until the end of 2025, and whether it still is in 2026 was not clear.',
  },
  {
    name: 'The dive boats',
    where: 'Honokōhau, about 4 mi',
    detail:
      'No shop picks up. A ride is roughly $15 to $22, and the manta boat is back around 21:00, when drivers are scarce, so the ride home is worth booking ahead. Kona Taxicab is 808-324-4444.',
  },
  {
    name: 'The car',
    where: 'Enterprise, in town',
    detail:
      'Saturday hours are only 9:00 to 12:00, it is closed on Sunday, and there are no after-hours returns. Returning it at KOA on the way to the flight fits, if a one-way return is allowed. Economy is roughly $60 to $90 a day.',
  },
];

const booking = [
  {
    label: 'The Mauna Kea tour',
    detail:
      'Thursday the 10th. Small vans, and the new moon is on the 8th, so the week is in demand. Ages 13 and up.',
  },
  {
    label: 'The manta boat',
    detail:
      'Tuesday afternoon, one diver and one snorkeller in a single booking, so both land on the same boat.',
  },
  {
    label: 'Discover Scuba',
    detail:
      'Wednesday morning. The PADI medical form comes first, and any yes on it needs a doctor’s sign-off, so it is worth reading well before December.',
  },
  {
    label: 'The Saturday car',
    detail: 'The town office has three hours on a Saturday, so it goes early.',
  },
];

const caveat =
  'Operator prices were checked on their own sites in September 2026 and are before tax. Ride fares, the car rate, the trolley fare and food prices are estimates. Hurricane Nolo closed the park and the Mauna Kea visitor station for a few days in late September; both are worth checking again in November.';

const note =
  `<strong style="color:#E9DCC3">${trip.name} · ${trip.dateLabel}</strong><br>` +
  `${nights} nights on the dry side of the Big Island, then Miami.`;
---

<BaseLayout
  title={trip.title}
  description={trip.description}
  path={trip.href}
  image={trip.cover}
  ogType="article"
>
  <TripHero trip={trip} maxWidth="17ch">Mantas after dark, dinner at <em>9,000 ft</em>.</TripHero>

  <TripNav sections={sections} />

  <TripShape paragraphs={paragraphs} notes={notes} />

  <section id="week" class="week">
    <div class="wrap">
      <SectionHead title="The shape of the week" note="Three days with something in them." />
      <ol class="timeline">
        {
          timeline.map((step) => (
            <li>
              <span class="when">{step.when}</span>
              <div>
                <b>{step.what}</b>
                <p>{step.detail}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="mauna-kea" class="mk">
    <div class="wrap">
      <div class="mk-cols">
        <div>
          <p class="mk-when">Thursday · new moon week</p>
          <h2>Dinner at 9,000 ft, then <em>the sky</em>.</h2>
          <ol class="mk-steps">
            {
              evening.map((e) => (
                <li>
                  <b>{e.step}</b>
                  <p>{e.detail}</p>
                </li>
              ))
            }
          </ol>
          <ul class="mk-tours">
            {
              tours.map((t) => (
                <li>
                  <div>
                    <a href={t.url}>{t.name}</a>
                    <span>{t.price}</span>
                  </div>
                  <p>{t.detail}</p>
                </li>
              ))
            }
          </ul>
        </div>
        <figure>
          <img
            src="/kona/img/maunakea.jpg"
            alt="The Milky Way arching over the dark summit ridge of Mauna Kea"
            loading="lazy"
            width="1920"
            height="1200"
          />
          <figcaption>
            <span>What is up that week</span>
            <ul class="mk-sky">{sky.map((thing) => <li>{thing}</li>)}</ul>
          </figcaption>
        </figure>
      </div>
      <p class="mk-note">
        The new moon is on the 8th, so Thursday is as dark as the mountain gets. The visitor station
        at 9,200 ft is free and open until 21:00, but its public telescopes stopped in 2019. It now
        runs one free telescope night a month by reservation: October's and November's fell on the
        10th, and December's date should appear in mid-November.
      </p>
    </div>
  </section>

  <ActivityGroups groups={groups} />

  <section id="around" class="stay">
    <div class="wrap">
      <SectionHead title="Getting around" note="No car for six of the seven days." />
      <ul class="places">
        {
          around.map((place) => (
            <li>
              <div class="who">
                <b>{place.name}</b>
                <span>{place.where}</span>
              </div>
              <p>{place.detail}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <BookingOrder
    intro="The house is done. Four things left, roughly in the order they stop being easy."
    items={booking}
    caveat={caveat}
  />

  <SiteFooter credits={trip.credits} note={note} />
</BaseLayout>

<style>
  .week,
  .stay {
    padding: 54px 0 62px;
  }

  .timeline,
  .places {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 2px;
  }

  .timeline li,
  .places li {
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 18px;
    padding: 18px 0;
    border-top: 1px solid rgba(26, 18, 13, 0.14);
  }

  .timeline li:last-child,
  .places li:last-child {
    border-bottom: 1px solid rgba(26, 18, 13, 0.14);
  }

  .timeline .when {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    padding-top: 3px;
    opacity: 0.72;
  }

  .timeline b,
  .places .who b {
    display: block;
    font-size: clamp(17px, 2vw, 20px);
  }

  .timeline p {
    margin: 6px 0 0;
    max-width: 62ch;
    opacity: 0.84;
  }

  .places li {
    grid-template-columns: 230px 1fr;
  }

  .places .who span {
    display: block;
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    opacity: 0.66;
  }

  .places p {
    margin: 0;
    max-width: 62ch;
    opacity: 0.84;
  }

  @media (max-width: 760px) {
    .timeline li,
    .places li {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }

  .mk {
    padding: 64px 0;
    background: var(--abyss);
    color: var(--foam);
  }

  .mk-cols {
    display: grid;
    gap: 36px;
  }

  .mk-when {
    margin: 0 0 12px;
    color: var(--surf);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .mk h2 {
    max-width: 16ch;
    font-size: clamp(30px, 5vw, 52px);
  }

  .mk h2 em {
    font-style: normal;
    color: var(--surf);
  }

  .mk-steps {
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 2px;
  }

  .mk-steps li {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 16px;
    padding: 14px 0;
    border-top: 1px solid rgba(214, 231, 227, 0.16);
  }

  .mk-steps b {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    padding-top: 3px;
    color: var(--surf);
  }

  .mk-steps p {
    margin: 0;
    max-width: 52ch;
    opacity: 0.86;
  }

  figure {
    margin: 0;
  }

  figure img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--r);
  }

  figcaption {
    margin-top: 16px;
  }

  figcaption span {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .mk-sky {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .mk-sky li {
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid rgba(214, 231, 227, 0.26);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .mk-note {
    max-width: 68ch;
    margin: 30px 0 0;
    padding-top: 18px;
    border-top: 1px solid rgba(214, 231, 227, 0.16);
    font-size: 15px;
    opacity: 0.72;
  }

  @media (min-width: 960px) {
    .mk-cols {
      grid-template-columns: 1.1fr 1fr;
      gap: 54px;
      align-items: start;
    }
  }

  @media (max-width: 760px) {
    .mk-steps li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }

  .mk-tours {
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 14px;
  }

  .mk-tours li {
    padding: 16px 18px;
    border-radius: 14px;
    border: 1px solid rgba(214, 231, 227, 0.16);
    background: rgba(214, 231, 227, 0.05);
  }

  .mk-tours div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 14px;
  }

  .mk-tours a {
    color: var(--foam);
    font-weight: 600;
    text-decoration-color: var(--surf);
    text-underline-offset: 3px;
  }

  .mk-tours span {
    color: var(--surf);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .mk-tours p {
    margin: 8px 0 0;
    font-size: 15px;
    opacity: 0.78;
  }
</style>
