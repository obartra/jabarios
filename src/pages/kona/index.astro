---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import TripNav from '../../components/TripNav.astro';
import TripHero from '../../components/TripHero.astro';
import TripShape from '../../components/TripShape.astro';
import SectionHead from '../../components/SectionHead.astro';
import ActivityGroups from '../../components/ActivityGroups.astro';
import BookingOrder from '../../components/BookingOrder.astro';
import { tripBySlug } from '../../data/trips.ts';
import { groupedFor } from '../../data/activities.ts';
import { durationDays, requireDates } from '../../lib/trips.ts';

const trip = tripBySlug('kona');
const groups = groupedFor('kona');
const nights = durationDays(requireDates(trip, trip.slug)) - 1;

const sections = [
  { href: '#week', label: 'The week' },
  { href: '#mauna-kea', label: 'Mauna Kea' },
  ...groups.map((g) => ({ href: `#${g.id}`, label: g.short })),
  { href: '#stay', label: 'Staying' },
];

const paragraphs = [
  'The Big Island rather than Oahu, because the manta night dive is off Kona and nowhere near Honolulu. About 200,000 people on an island bigger than all the others put together, and an open-air airport where everyone walks down the stairs into the sun.',
  'Three days have something in them. The others are free, and the cards further down are for those, or for nothing.',
];

const notes = [
  {
    lead: 'Diving and altitude do not mix.',
    rest: 'The mountain and the flight home both want a clear day after the last dive, which is what sets the order: underwater Tuesday and Wednesday, Mauna Kea on Thursday, and dry land from then on.',
  },
  {
    lead: 'Mornings are for work, for whoever is working.',
    rest: 'Kona is 5 hours behind Miami, so a 9:00 Miami start is 4:00 here and the workday is over by lunch.',
  },
  {
    lead: 'A car for the week, from KOA.',
    rest: 'Turo works on the island, but the pickups and returns eat the saving. The bus is no use in the evening, and rideshare thins out fast after dark.',
  },
  {
    lead: 'The night things come with a driver.',
    rest: 'The dive boat returns to a harbour ten minutes from town, and the Mauna Kea tour drives the mountain.',
  },
];

/** Three fixed days, in the order the diving and the altitude allow. */
const timeline = [
  {
    when: 'Sun 6 Dec',
    what: 'Into Kona',
    detail: 'Collect the car at KOA, and it is ten minutes to town.',
  },
  {
    when: 'Mon 7 Dec',
    what: 'Nothing booked',
    detail: 'A walk, a snorkel at Kahalu‘u with the turtles, and getting over the Pacific.',
  },
  {
    when: 'Tue 8 · afternoon',
    what: 'The mantas',
    detail:
      'One boat for both of us. Two tanks for Os, a day dive then the mantas after dark, and Jabari snorkels them from the surface under the same lights.',
  },
  {
    when: 'Wed 9 · morning',
    what: 'Jabari’s first dive',
    detail:
      'Discover Scuba on a day charter. Os along on the boat, or a morning off. Done by lunch, which leaves a full day before the mountain.',
  },
  {
    when: 'Thu 10 Dec',
    what: 'Mauna Kea',
    detail:
      'Picked up between 13:30 and 15:00, back between 21:00 and 22:00. The whole evening is below.',
  },
  {
    when: 'Fri 11 Dec',
    what: 'Free, and dry',
    detail: 'The coffee farms in Holualoa, a long lunch, or nothing.',
  },
  {
    when: 'Sat 12 Dec',
    what: 'A car day',
    detail:
      'Volcanoes National Park at a proper pace, Punalu‘u on the way, and a last dinner in town.',
  },
  {
    when: 'Sun 13 Dec',
    what: 'Breakfast, then KOA',
    detail: 'Car back at the airport, and on to Miami.',
  },
];

/** The Thursday, in order. */
const evening = [
  {
    step: 'Kailua-Kona',
    detail:
      'Pickup in town, then a 4WD van up the mountain, which rental cars are not allowed to drive.',
  },
  {
    step: '9,000 ft',
    detail:
      'A hot dinner at the mid-level station, partly for the food and partly to adjust to the height.',
  },
  {
    step: 'Nearly 14,000 ft',
    detail:
      'Sunset from the summit, above the clouds, among the big research observatories. Parkas and gloves are provided, because it is close to freezing up there.',
  },
  {
    step: 'Back to 9,000 ft',
    detail:
      'A private telescope session with hot drinks. They shoot deep-sky photos during it and send them afterwards.',
  },
];

const sky = ['Jupiter', 'Saturn', 'Andromeda', 'The Orion Nebula', 'The Milky Way'];

const stays = [
  {
    name: 'Holualoa',
    where: '10 minutes above town',
    detail:
      'Up in the coffee hills: cooler, quiet, and more standalone homes than anywhere near the water.',
  },
  {
    name: 'Keauhou',
    where: 'South of Kailua-Kona',
    detail:
      'Closest to Manta Village and the Keauhou boats, still an easy drive into town for dinner.',
  },
  {
    name: 'Captain Cook and Kealakekua',
    where: '25 to 40 minutes south',
    detail: 'Greener and further out, and the closest base for Two Step and Kealakekua Bay.',
  },
  {
    name: 'Kailua-Kona',
    where: 'The town itself',
    detail:
      'Walkable to dinners, dive shops and coffee, but mostly condo complexes rather than a house to ourselves.',
  },
];

const booking = [
  {
    label: 'The Mauna Kea tour',
    detail:
      'Small vans, and a new-moon week is when everyone wants to go. Thursday the 10th, with pickup in Kailua-Kona.',
  },
  {
    label: 'The manta boat',
    detail:
      'Tuesday afternoon, one diver on the two-tank trip and one snorkeller, on the same boat. Direct with a Kona shop rather than a booking site.',
  },
  {
    label: 'Discover Scuba',
    detail:
      'Wednesday morning on a day charter. The medical questionnaire comes first, so worth reading early.',
  },
  {
    label: 'A whole home and a car',
    detail:
      'Off-street parking, a desk, and a speed test in the listing, and the car at KOA for the week. December is busy on the island.',
  },
];

const caveat =
  'Prices on the cards came from planning in September 2026 and were not checked with the operators. The tour times are the operator’s; the park fee is the firmest number here. Kīlauea changes week to week.';

const note =
  `<strong style="color:#E9DCC3">${trip.name} · ${trip.dateLabel}</strong><br>` +
  `${nights} nights on the dry side of the Big Island, then Miami.`;
---

<BaseLayout
  title={trip.title}
  description={trip.description}
  path={trip.href}
  image={trip.cover}
  ogType="article"
>
  <TripHero trip={trip} maxWidth="17ch">Mantas after dark, dinner at <em>9,000 ft</em>.</TripHero>

  <TripNav sections={sections} />

  <TripShape paragraphs={paragraphs} notes={notes} />

  <section id="week" class="week">
    <div class="wrap">
      <SectionHead title="The shape of the week" note="Three days with something in them." />
      <ol class="timeline">
        {
          timeline.map((step) => (
            <li>
              <span class="when">{step.when}</span>
              <div>
                <b>{step.what}</b>
                <p>{step.detail}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="mauna-kea" class="mk">
    <div class="wrap">
      <div class="mk-cols">
        <div>
          <p class="mk-when">Thursday · new moon week</p>
          <h2>Dinner at 9,000 ft, then <em>the sky</em>.</h2>
          <ol class="mk-steps">
            {
              evening.map((e) => (
                <li>
                  <b>{e.step}</b>
                  <p>{e.detail}</p>
                </li>
              ))
            }
          </ol>
        </div>
        <figure>
          <img
            src="/kona/img/maunakea.jpg"
            alt="The Milky Way arching over the dark summit ridge of Mauna Kea"
            loading="lazy"
            width="1920"
            height="1200"
          />
          <figcaption>
            <span>What is up that week</span>
            <ul class="mk-sky">{sky.map((thing) => <li>{thing}</li>)}</ul>
          </figcaption>
        </figure>
      </div>
      <p class="mk-note">
        No moon means the darkest sky the mountain gets. The visitor station at 9,200 ft is open in
        the evenings and reachable in a normal car, but its public telescopes stopped in 2019, so
        the tour is the version with a telescope in it.
      </p>
    </div>
  </section>

  <ActivityGroups groups={groups} />

  <section id="stay" class="stay">
    <div class="wrap">
      <SectionHead
        title="Where to stay"
        note="A house to ourselves, with parking. All of these are within 40 minutes of the harbour."
      />
      <ul class="places">
        {
          stays.map((place) => (
            <li>
              <div class="who">
                <b>{place.name}</b>
                <span>{place.where}</span>
              </div>
              <p>{place.detail}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <BookingOrder
    intro="Four things, roughly in the order they stop being easy."
    items={booking}
    caveat={caveat}
  />

  <SiteFooter credits={trip.credits} note={note} />
</BaseLayout>

<style>
  .week,
  .stay {
    padding: 54px 0 62px;
  }

  .timeline,
  .places {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 2px;
  }

  .timeline li,
  .places li {
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 18px;
    padding: 18px 0;
    border-top: 1px solid rgba(26, 18, 13, 0.14);
  }

  .timeline li:last-child,
  .places li:last-child {
    border-bottom: 1px solid rgba(26, 18, 13, 0.14);
  }

  .timeline .when {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    padding-top: 3px;
    opacity: 0.72;
  }

  .timeline b,
  .places .who b {
    display: block;
    font-size: clamp(17px, 2vw, 20px);
  }

  .timeline p {
    margin: 6px 0 0;
    max-width: 62ch;
    opacity: 0.84;
  }

  .places li {
    grid-template-columns: 230px 1fr;
  }

  .places .who span {
    display: block;
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    opacity: 0.66;
  }

  .places p {
    margin: 0;
    max-width: 62ch;
    opacity: 0.84;
  }

  @media (max-width: 760px) {
    .timeline li,
    .places li {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }

  .mk {
    padding: 64px 0;
    background: var(--abyss);
    color: var(--foam);
  }

  .mk-cols {
    display: grid;
    gap: 36px;
  }

  .mk-when {
    margin: 0 0 12px;
    color: var(--surf);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .mk h2 {
    max-width: 16ch;
    font-size: clamp(30px, 5vw, 52px);
  }

  .mk h2 em {
    font-style: normal;
    color: var(--surf);
  }

  .mk-steps {
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 2px;
  }

  .mk-steps li {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 16px;
    padding: 14px 0;
    border-top: 1px solid rgba(214, 231, 227, 0.16);
  }

  .mk-steps b {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    padding-top: 3px;
    color: var(--surf);
  }

  .mk-steps p {
    margin: 0;
    max-width: 52ch;
    opacity: 0.86;
  }

  figure {
    margin: 0;
  }

  figure img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--r);
  }

  figcaption {
    margin-top: 16px;
  }

  figcaption span {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .mk-sky {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .mk-sky li {
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid rgba(214, 231, 227, 0.26);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .mk-note {
    max-width: 68ch;
    margin: 30px 0 0;
    padding-top: 18px;
    border-top: 1px solid rgba(214, 231, 227, 0.16);
    font-size: 15px;
    opacity: 0.72;
  }

  @media (min-width: 960px) {
    .mk-cols {
      grid-template-columns: 1.1fr 1fr;
      gap: 54px;
      align-items: start;
    }
  }

  @media (max-width: 760px) {
    .mk-steps li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
