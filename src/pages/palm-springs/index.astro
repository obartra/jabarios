---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import TripNav from '../../components/TripNav.astro';
import TripHero from '../../components/TripHero.astro';
import TripShape from '../../components/TripShape.astro';
import ActivityGroups from '../../components/ActivityGroups.astro';
import BookingOrder from '../../components/BookingOrder.astro';
import { tripBySlug } from '../../data/trips.ts';
import { groupedFor } from '../../data/activities.ts';

const trip = tripBySlug('palm-springs');
const groups = groupedFor('palm-springs');
const sections = groups.map((g) => ({ href: `#${g.id}`, label: g.short }));

const paragraphs = [
  'A pile of things that looked good, not a plan. Nothing is booked and nothing is decided. Some of it we might do together, some in pairs, some not at all. Tentatively some time in April, no exact dates or length yet.',
  'Prices are per person unless a card says otherwise, and they are roughly what to expect rather than a quote.',
];

const notes = [
  {
    lead: 'April, probably.',
    rest: 'Nothing is fixed, but April is the working idea, and Os may be in San Francisco beforehand, which makes flying down the easy way in.',
  },
  {
    lead: 'April means festivals.',
    rest: 'Coachella and Stagecoach take three April weekends, and rooms that go for $120 to $180 on an ordinary night have been running $400 to $800 on those. The 2027 dates are the first thing to check before picking a week.',
  },
  {
    lead: 'Spring is windy.',
    rest: 'April is the second windiest month, which is the one thing that threatens the balloon.',
  },
];

const booking = [
  {
    label: 'Somewhere to stay',
    detail:
      "The one that actually matters, once there are dates. Houses with a pool go months ahead, and festival weekends drive the whole valley's prices.",
  },
  {
    label: 'Sunnylands',
    detail:
      'House tickets drop at 09:00 Pacific on the 15th of the preceding month and go in minutes.',
  },
  { label: 'The Integratron', detail: 'Sound baths sell out weeks to months ahead.' },
  {
    label: 'A balloon',
    detail: 'Small daily capacity, and spring wind cancels more flights than other months.',
  },
  {
    label: 'A car',
    detail: 'Not optional. Everything outside downtown assumes one.',
  },
  { label: 'The Frey House', detail: '48 hours notice minimum, if the architecture appeals.' },
];

const caveat =
  'Prices and opening hours here were checked in September 2026 and none of it is booked. Worth confirming once there are dates.';

const note =
  `<strong style="color:#E9DCC3">${trip.name} · ${trip.dateLabel}</strong><br>` +
  'Tentatively April, dates still open.';
---

<BaseLayout
  title={trip.title}
  description={trip.description}
  path={trip.href}
  image={trip.cover}
  ogType="article"
>
  <TripHero trip={trip}>April, probably, in the <em>desert</em>.</TripHero>

  <TripNav sections={sections} />

  <TripShape paragraphs={paragraphs} notes={notes} />

  <ActivityGroups groups={groups} />

  <BookingOrder
    intro="Only relevant for whatever we actually feel like doing. Roughly in the order things stop being available."
    items={booking}
    caveat={caveat}
  />

  <SiteFooter credits={trip.credits} note={note} />
</BaseLayout>
