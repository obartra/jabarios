---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import TripNav from '../../components/TripNav.astro';
import TripHero from '../../components/TripHero.astro';
import TripShape from '../../components/TripShape.astro';
import ActivityGroups from '../../components/ActivityGroups.astro';
import BookingOrder from '../../components/BookingOrder.astro';
import { tripBySlug } from '../../data/trips.ts';
import { groupedFor } from '../../data/activities.ts';
import { durationDays } from '../../lib/trips.ts';

const trip = tripBySlug('vegas');
const groups = groupedFor('vegas');
const nights = durationDays(trip) - 1;

const sections = groups.map((g) => ({ href: `#${g.id}`, label: g.short }));

const paragraphs = [
  'This is a pile of things that looked fun, not a plan. Nothing is booked and nothing is decided. Some of it we might do all together, some in twos, some not at all, and that is the whole point of writing it down rather than agreeing an itinerary.',
  'Prices are per person unless a card says otherwise, and they are roughly what to expect rather than a quote.',
];

const notes = [
  {
    lead: `${nights} nights is a long time in Vegas.`,
    rest: 'The Strip wears thin well before the last day, which is why about a third of the cards below are an hour or more out of town.',
  },
  {
    lead: 'Nothing on this list is a casino.',
    rest: 'If a hotel without a slot floor appeals, Vdara and the Waldorf Astoria are both at CityCenter, non-gaming, non-smoking, and do two-bedroom suites.',
  },
  {
    lead: 'The rodeo misses us.',
    rest: 'The National Finals Rodeo runs 3 to 12 December, so it is gone before we land. Christmas week is still busy and priced like it.',
  },
  {
    lead: 'December is properly cold after dark.',
    rest: 'Highs around 14°C, lows near 4°C. Every outdoor thing here wants a coat.',
  },
];

const booking = [
  { label: '"O"', detail: 'Christmas week fills up, and it does not run every night.' },
  { label: 'Helicopter', detail: 'Afternoon slots go first, and winter weather cancels.' },
  { label: 'Skydive', detail: 'Morning slots are the calm ones and the popular ones.' },
  {
    label: 'Battlefield Vegas',
    detail:
      'Worth a phone call rather than a web booking, since only the two-person package is published.',
  },
  { label: 'Omega Mart, Neon Museum', detail: 'Both timed entry, and dusk goes first.' },
  { label: 'A car', detail: 'Needed for anything in the out-of-town section.' },
];

const caveat =
  'Prices and schedules here were checked in August 2026 and none of it is booked. Worth confirming before anyone plans a day around it, especially on 24 and 25 December, when opening hours across the city move.';

const note =
  `<strong style="color:#E9DCC3">${trip.name} · ${trip.dateLabel}</strong><br>` +
  'Four of us, nine nights, arriving on the 18th and flying home on the 27th.';
---

<BaseLayout
  title={trip.title}
  description={trip.description}
  path={trip.href}
  image={trip.cover}
  ogType="article"
>
  <TripHero trip={trip}>Christmas in Vegas. <em>Help yourself</em>.</TripHero>

  <TripNav sections={sections} />

  <TripShape paragraphs={paragraphs} notes={notes} />

  <ActivityGroups groups={groups} />

  <BookingOrder
    intro="Only relevant for whatever we actually feel like doing. Roughly in the order things stop being available."
    items={booking}
    caveat={caveat}
  />

  <SiteFooter credits={trip.credits} note={note} />
</BaseLayout>
