---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import TripNav from '../../components/TripNav.astro';
import TripHero from '../../components/TripHero.astro';
import TripShape from '../../components/TripShape.astro';
import SectionHead from '../../components/SectionHead.astro';
import ActivityGroups from '../../components/ActivityGroups.astro';
import { tripBySlug } from '../../data/trips.ts';
import { groupedFor } from '../../data/activities.ts';

const trip = tripBySlug('vietnam');
const groups = groupedFor('vietnam');

const sections = [
  { href: '#days', label: 'The days' },
  ...groups.map((g) => ({ href: `#${g.id}`, label: g.short })),
  { href: '#more', label: 'More' },
];

const paragraphs = [
  'The end of Os’s fortnight in Vietnam with family, and the start of ours. Jabari arrives on the 13th, and for two and a half days it is the four of us in the Old Quarter.',
  'No day trips, because there is no time for them. Everything below is walkable or a short ride, and nothing on this page is booked.',
];

const notes = [
  {
    lead: 'Four of us, so a gentle pace.',
    rest: 'Mornings for the sights, afternoons slow, and the evenings for eating.',
  },
  {
    lead: 'Thursday ends at 15:30.',
    rest: 'One car to Noi Bai for all four of us. The morning still has room for the Temple of Literature or a last coffee.',
  },
  {
    lead: 'Weekday Hanoi.',
    rest: 'The walking street round the lake and the weekend night market both run Friday to Sunday, so they miss us.',
  },
  {
    lead: 'Warm, with showers.',
    rest: 'Around 29°C by day and 22°C at night, short showers on some days, and sunset at about 17:30.',
  },
];

const days = [
  {
    when: 'Tue 13 Oct',
    what: 'Jabari arrives',
    detail: 'The lake at dusk, egg coffee, and the 17:20 water puppets if everyone has the energy.',
  },
  {
    when: 'Wed 14 Oct',
    what: 'The full day',
    detail:
      'West Lake or the Temple of Literature in the morning, a slow afternoon, Long Biên at sunset, and the street food walk at 17:00 or 18:30.',
  },
  {
    when: 'Thu 15 Oct',
    what: 'Out at 15:30',
    detail:
      'A last morning in the Old Quarter, then the car to the airport. Os’s parents fly home to Barcelona, and the two of us fly to Bangkok.',
  },
];

const more = [
  {
    name: 'Hoa Lo Prison',
    where: '50,000 VND · 15 minutes on foot',
    detail:
      'The colonial prison later known as the Hanoi Hilton. Sobering, and an hour or so is enough. The night tours only run on weekends.',
  },
  {
    name: 'Museum of Ethnology',
    where: '40,000 VND · 25 minutes by Grab',
    detail:
      'The best museum in the city, with full-size village houses outside that suit all ages. Half a day, closed Mondays.',
  },
  {
    name: 'A cooking class',
    where: 'About $45 each',
    detail:
      'Rose Kitchen starts with a market visit and picks up in the Old Quarter. A good half-day for four.',
  },
  {
    name: 'GC Bar',
    where: 'Old Quarter · weeknights from 17:00',
    detail: 'Hanoi’s longest-running gay bar, relaxed on a weeknight, with a pool table.',
  },
];

const note =
  `<strong style="color:#E9DCC3">${trip.name} · ${trip.dateLabel}</strong><br>` +
  'With Os’s parents, then Bangkok together.';
---

<BaseLayout
  title={trip.title}
  description={trip.description}
  path={trip.href}
  image={trip.cover}
  ogType="article"
>
  <TripHero trip={trip} maxWidth="17ch">Two and a half days in <em>Hanoi</em>.</TripHero>

  <TripNav sections={sections} />

  <TripShape paragraphs={paragraphs} notes={notes} />

  <section id="days" class="list">
    <div class="wrap">
      <SectionHead title="The days" note="One rough shape, easy to ignore." />
      <ul class="places">
        {
          days.map((d) => (
            <li>
              <div class="who">
                <b>{d.what}</b>
                <span>{d.when}</span>
              </div>
              <p>{d.detail}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ActivityGroups groups={groups} />

  <section id="more" class="list">
    <div class="wrap">
      <SectionHead title="If there is time" note="Good, just not first." />
      <ul class="places">
        {
          more.map((m) => (
            <li>
              <div class="who">
                <b>{m.name}</b>
                <span>{m.where}</span>
              </div>
              <p>{m.detail}</p>
            </li>
          ))
        }
      </ul>
      <p class="caveat">
        Prices and hours were researched in September 2026, mostly from travel guides rather than
        official pages, so worth a check before relying on them.
      </p>
    </div>
  </section>

  <SiteFooter credits={trip.credits} note={note} />
</BaseLayout>

<style>
  .list {
    padding: 54px 0 30px;
  }

  .places {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 2px;
  }

  .places li {
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: 18px;
    padding: 18px 0;
    border-top: 1px solid rgba(26, 18, 13, 0.14);
  }

  .places li:last-child {
    border-bottom: 1px solid rgba(26, 18, 13, 0.14);
  }

  .places .who b {
    display: block;
    font-size: clamp(17px, 2vw, 20px);
  }

  .places .who span {
    display: block;
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    opacity: 0.72;
  }

  .places p {
    margin: 0;
    max-width: 62ch;
    opacity: 0.84;
  }

  .caveat {
    margin: 22px 0 0;
    max-width: 62ch;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.7;
    opacity: 0.72;
  }

  @media (max-width: 760px) {
    .places li {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
